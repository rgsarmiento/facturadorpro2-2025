{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": [
    "resources/**/*",
    "modules/**/*"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "storage",
    "bootstrap/cache"
  ],
  "vueCompilerOptions": {
    "target": 3
  }
}
