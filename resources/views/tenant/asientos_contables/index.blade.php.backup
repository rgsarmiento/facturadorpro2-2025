                                <thead class="thead-light">
                                    <tr>
                                        <th>Número</th>
                                        <th>Fecha</th>
                                        <th>Tipo</th>
                                        <th>Concepto</th>
                                        <th>Total</th>
                                        <th>Estado</th>
                                        <th>Creado por</th>
                                        <th width="120">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="record in records" :key="record.id">
                                        <td>
                                            <a :href="`/contabilidad/asientos-contables/${record.id}`"
                                               class="text-primary"
                                               v-text="record.numero_comprobante">
                                            </a>
                                        </td>
                                        <td v-text="formatDate(record.fecha_asiento)"></td>
                                        <td v-text="record.tipo_comprobante && record.tipo_comprobante.nombre ? record.tipo_comprobante.nombre : ''"></td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;" 
                                                 :title="record.concepto"
                                                 v-text="record.concepto">
                                            </div>
                                        </td>
                                        <td v-text="formatCurrency(record.total_debito)"></td>
                                        <td>
                                            <span :class="getEstadoClass(record.estado)"
                                                  v-text="record.estado">
                                            </span>
                                        </td>
                                        <td v-text="record.usuario_creacion && record.usuario_creacion.name ? record.usuario_creacion.name : ''"></td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a :href="`/contabilidad/asientos-contables/${record.id}`"
