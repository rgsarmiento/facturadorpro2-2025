                                                  v-text="record.estado">
                                            </span>
                                        </td>
                                        <td v-text="record.usuario_creacion && record.usuario_creacion.name ? record.usuario_creacion.name : ''"></td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a :href="`/contabilidad/asientos-contables/${record.id}`"
                                                   class="btn btn-info btn-sm" 
                                                   title="Ver">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a v-if="record.estado === 'BORRADOR'"
                                                   :href="`/contabilidad/asientos-contables/${record.id}/edit`"
                                                   class="btn btn-warning btn-sm" 
                                                   title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button v-if="record.estado === 'BORRADOR'"
