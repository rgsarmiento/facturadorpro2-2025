                                        <td v-text="record.tipo_comprobante && record.tipo_comprobante.nombre ? record.tipo_comprobante.nombre : ''"></td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;" 
                                                 :title="record.concepto"
                                                 v-text="record.concepto">
                                            </div>
                                        </td>
